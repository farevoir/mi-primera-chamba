{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Edit(./my-data/**)",
      "Bash(node scripts/html-to-pdf.mjs *)",
      "PowerShell(node scripts/html-to-pdf.mjs *)",
      "Bash(node scripts/jobs.mjs *)",
      "PowerShell(node scripts/jobs.mjs *)",
      "Bash(node scripts/sync-data.mjs *)",
      "PowerShell(node scripts/sync-data.mjs *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/sync-data.mjs pull", "timeout": 60, "statusMessage": "Syncing my-data" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/sync-data.mjs push", "timeout": 60 }
        ]
      }
    ]
  }
}
